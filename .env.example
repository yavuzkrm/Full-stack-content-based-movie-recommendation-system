# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" itself is git-ignored on purpose — never commit real secrets.

# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# MySQL connection details
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=your_mysql_password_here
MYSQLDATABASE=film_oneri

# Any long random string — used to sign login-session cookies.
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_string
